# Copia este archivo a .env para sobreescribir los valores por defecto del
# docker-compose. TODOS son solo para desarrollo local; en producción se
# inyectan por variables de entorno / Key Vault.

# PostgreSQL
POSTGRES_USER=frafactu
POSTGRES_PASSWORD=frafactu_dev
POSTGRES_DB=frafactu

# Backend
JWT_SECRET_KEY=dev-solo-cambiar-en-produccion-clave-larga-de-al-menos-32-bytes
# Clave AES-256 en Base64 (exactamente 32 bytes). Generar una propia para prod.
ENCRYPTION_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Bootstrap del primer admin (seeder de arranque). Si dejas AdminPassword vacío,
# NO se crea ningún usuario (nunca hay clave por defecto); solo se siembran los
# roles. El admin nace con cambio de contraseña obligatorio en el primer ingreso.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NOMBRE=Administrador
# Solo en Development: si es true, siembra un tenant de ejemplo
# (emisor + sucursal + caja + EmisorAdmin + Cajero demo).
BOOTSTRAP_SEED_SAMPLE_DATA=false

# Frontend
VITE_API_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=
